# ===================== BANCO DE DADOS (Postgres) =====================
DB_NAME=db_aplication
DB_USER=your_user
DB_PASSWORD=your_password
DB_PORT=5432

# ===================== BACK-END (Flask) =====================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=0
# 0.0.0.0 é necessário para o debugger ser alcançável via port-forward do Docker;
# só use 127.0.0.1 se estiver rodando fora de container
DEBUG_HOST=0.0.0.0
DEBUG_PORT=5678

# ===================== FRONT-END (Vue) =====================
FRONTEND_PORT=8080
API_URL=http://localhost:5000
